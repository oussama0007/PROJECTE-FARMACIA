FROM php:8.5-apache-trixie
RUN apt-get update && apt-get install -y --no-install-recommends libonig-dev libxml2-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev libwebp-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install mbstring dom gd \
    && rm -rf /var/lib/apt/lists/*
